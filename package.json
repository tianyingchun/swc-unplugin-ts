{
  "name": "@hyperse/unplugin-swc",
  "version": "2.0.0",
  "description": "SWC plugin for Vite and Rollup supporting ESM modules",
  "homepage": "https://github.com/hyperse-io/unplugin-swc/tree/main/#readme",
  "bugs": {
    "url": "https://github.com/hyperse-io/unplugin-swc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/unplugin-swc.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsup",
    "g:changeset": "changeset",
    "g:cz": "cz",
    "g:release": "yarn build && changeset publish",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "^6.x"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.4.0",
    "defu": "^6.1.7",
    "get-tsconfig": "^4.14.3",
    "path-exists": "^5.0.0",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "rollup": "^4.64.6",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@swc/core": ">=1.3.42"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public"
  }
}
